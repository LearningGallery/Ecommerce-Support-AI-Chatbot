# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# OpenSearch Configuration
OPENSEARCH_ENDPOINT=https://your-opensearch-endpoint.ap-southeast-1.es.amazonaws.com
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your-password
OPENSEARCH_INDEX_NAME=ecommerce-faq

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=ecommerce-chatbot-dev-sessions

# S3 Configuration
S3_DOCUMENTS_BUCKET=ecommerce-chatbot-dev-documents

# Application Configuration
LOG_LEVEL=INFO
ALLOWED_CORS_ORIGINS=*
MAX_TOKENS=1024
TEMPERATURE=0.7
SESSION_TTL_HOURS=24

# RAG Configuration
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.7
CHUNK_SIZE=512
CHUNK_OVERLAP=50