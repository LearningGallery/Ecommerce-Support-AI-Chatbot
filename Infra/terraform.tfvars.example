# Project Configuration
project_name = "ecommerce-chatbot"
environment  = "dev"
owner_email  = "your-email@example.com"

# AWS Configuration
aws_region         = "ap-southeast-1"
availability_zones = ["ap-southeast-1a", "ap-southeast-1b"]

# Network Configuration
vpc_cidr           = "10.0.0.0/16"
enable_nat_gateway = true
single_nat_gateway = false  # Set to true to use single NAT Gateway (cost savings)

# OpenSearch Configuration
opensearch_instance_type   = "t3.small.search"
opensearch_instance_count  = 1
opensearch_ebs_volume_size = 10

# ECS Configuration
ecs_task_cpu           = 512
ecs_task_memory        = 1024
backend_desired_count  = 2
frontend_desired_count = 2

# Bedrock Configuration
bedrock_model_id = "anthropic.claude-3-5-sonnet-20241022-v2:0"

# Security & Monitoring
enable_waf                = false  # Set to true to enable AWS WAF
enable_container_insights = true
log_retention_days        = 7

# CORS Configuration
allowed_cors_origins = ["*"]  # Restrict this in production

# Cost Optimization for Demo/Dev
# Uncomment these for minimum cost configuration:
# opensearch_instance_count = 1
# backend_desired_count     = 1
# frontend_desired_count    = 1
# single_nat_gateway        = true
# enable_waf                = false
# log_retention_days        = 1